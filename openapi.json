{
    "openapi": "3.1.0",
    "info": {
        "title": "KOPNUS API",
        "description": "Member financial transaction API",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api/v1",
            "description": "Versioned API root"
        }
    ],
    "paths": {
        "/auth/login": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Exchange credentials for a bearer token",
                "description": "Public endpoint. Returns a short-lived HS256 token and allows 5 attempts per minute per IP.",
                "operationId": "login",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "member@example.test"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password"
                                    }
                                },
                                "required": [
                                    "email",
                                    "password"
                                ]
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Credentials accepted. Token issued.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Authenticated."
                                        },
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "access_token": {
                                                    "type": "string"
                                                },
                                                "token_type": {
                                                    "type": "string",
                                                    "example": "Bearer"
                                                },
                                                "expires_in": {
                                                    "type": "integer",
                                                    "example": 3600
                                                }
                                            }
                                        },
                                        "errors": {
                                            "type": "array",
                                            "items": {
                                                "type": "object"
                                            },
                                            "example": []
                                        }
                                    },
                                    "required": [
                                        "success",
                                        "message",
                                        "data",
                                        "errors"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Email or password is incorrect.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorEnvelope"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Payload validation failed.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorEnvelope"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many login attempts from this IP.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorEnvelope"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/transactions/deposit": {
            "post": {
                "tags": [
                    "Transactions"
                ],
                "summary": "Deposit funds into the authenticated account",
                "description": "Requires a bearer token and a unique Idempotency-Key header. Replays the stored response for a repeated key with the same payload, and returns 409 for a different payload or while the original request is still processing.",
                "operationId": "deposit",
                "parameters": [
                    {
                        "name": "Idempotency-Key",
                        "in": "header",
                        "description": "Client generated key, at most 255 characters, unique per user and operation.",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "maxLength": 255
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "amount": {
                                        "type": "integer",
                                        "minimum": 1,
                                        "maximum": 25000000,
                                        "example": 100000
                                    }
                                },
                                "required": [
                                    "amount"
                                ]
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Deposit accepted. Balance and ledger entry returned.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Deposit successful."
                                        },
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "balance": {
                                                    "type": "integer",
                                                    "example": 150000
                                                },
                                                "transaction": {
                                                    "type": "object",
                                                    "properties": {
                                                        "transaction_id": {
                                                            "type": "string",
                                                            "example": "271126-a1b2-c3d4e5"
                                                        },
                                                        "type": {
                                                            "type": "string",
                                                            "example": "deposit"
                                                        },
                                                        "amount": {
                                                            "type": "integer",
                                                            "example": 100000
                                                        },
                                                        "balance_before": {
                                                            "type": "integer",
                                                            "example": 50000
                                                        },
                                                        "balance_after": {
                                                            "type": "integer",
                                                            "example": 150000
                                                        },
                                                        "created_at": {
                                                            "type": "string",
                                                            "format": "date-time"
                                                        }
                                                    }
                                                }
                                            }
                                        },
                                        "errors": {
                                            "type": "array",
                                            "items": {
                                                "type": "object"
                                            },
                                            "example": []
                                        }
                                    },
                                    "required": [
                                        "success",
                                        "message",
                                        "data",
                                        "errors"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Bearer token missing, invalid, or expired.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorEnvelope"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "The authenticated user has no account.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorEnvelope"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "The idempotency key is already in use with a different payload or is still processing.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorEnvelope"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Payload validation failed or the Idempotency-Key header is missing or too long.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorEnvelope"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/transactions/withdraw": {
            "post": {
                "tags": [
                    "Transactions"
                ],
                "summary": "Withdraw funds from the authenticated account",
                "description": "Requires a bearer token and a unique Idempotency-Key header. Replays the stored response for a repeated key with the same payload, and returns 409 for a different payload or while the original request is still processing.",
                "operationId": "withdraw",
                "parameters": [
                    {
                        "name": "Idempotency-Key",
                        "in": "header",
                        "description": "Client generated key, at most 255 characters, unique per user and operation.",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "maxLength": 255
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "amount": {
                                        "type": "integer",
                                        "minimum": 1,
                                        "maximum": 25000000,
                                        "example": 100000
                                    }
                                },
                                "required": [
                                    "amount"
                                ]
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Withdrawal accepted. Balance and ledger entry returned.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Withdrawal successful."
                                        },
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "balance": {
                                                    "type": "integer",
                                                    "example": 50000
                                                },
                                                "transaction": {
                                                    "type": "object",
                                                    "properties": {
                                                        "transaction_id": {
                                                            "type": "string",
                                                            "example": "271126-a1b2-c3d4e5"
                                                        },
                                                        "type": {
                                                            "type": "string",
                                                            "example": "withdraw"
                                                        },
                                                        "amount": {
                                                            "type": "integer",
                                                            "example": 100000
                                                        },
                                                        "balance_before": {
                                                            "type": "integer",
                                                            "example": 150000
                                                        },
                                                        "balance_after": {
                                                            "type": "integer",
                                                            "example": 50000
                                                        },
                                                        "created_at": {
                                                            "type": "string",
                                                            "format": "date-time"
                                                        }
                                                    }
                                                }
                                            }
                                        },
                                        "errors": {
                                            "type": "array",
                                            "items": {
                                                "type": "object"
                                            },
                                            "example": []
                                        }
                                    },
                                    "required": [
                                        "success",
                                        "message",
                                        "data",
                                        "errors"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Bearer token missing, invalid, or expired.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorEnvelope"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "The authenticated user has no account.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorEnvelope"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "The idempotency key is already in use with a different payload or is still processing.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorEnvelope"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Returns VALIDATION_FAILED for an invalid amount or a missing or oversized Idempotency-Key, and INSUFFICIENT_BALANCE when the amount exceeds the available balance.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorEnvelope"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "ApiErrorEntry": {
                "type": "object",
                "description": "One error entry inside the response envelope.",
                "properties": {
                    "code": {
                        "type": "string",
                        "example": "INVALID_CREDENTIALS"
                    },
                    "field": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "email"
                    },
                    "message": {
                        "type": "string",
                        "example": "Email or password is incorrect."
                    }
                },
                "required": [
                    "code",
                    "field",
                    "message"
                ]
            },
            "ApiErrorEnvelope": {
                "type": "object",
                "description": "Envelope returned by every API error response.",
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": false
                    },
                    "message": {
                        "type": "string",
                        "example": "Email or password is incorrect."
                    },
                    "data": {
                        "type": [
                            "object",
                            "null"
                        ]
                    },
                    "errors": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ApiErrorEntry"
                        }
                    }
                },
                "required": [
                    "success",
                    "message",
                    "data",
                    "errors"
                ]
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "description": "HS256 bearer token issued by the login endpoint.",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    },
    "tags": [
        {
            "name": "Authentication",
            "description": "Authentication"
        },
        {
            "name": "Transactions",
            "description": "Transactions"
        }
    ]
}